{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n laravel,vite -c green,cyan \"php artisan serve --host=localhost --port=8000\" \"vite\"",
        "dev:assets": "vite",
        "serve": "php artisan serve --host=localhost --port=8000",
        "build": "npm run clean:hot && vite build",
        "clean:hot": "node scripts/clean-hot.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.9.1",
        "framer-motion": "^14.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
